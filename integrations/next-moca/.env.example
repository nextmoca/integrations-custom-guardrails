# Copy to .env and fill in. Do NOT commit .env.

# --- Next Moca account ---
# API key minted in the Next Moca console: https://console.nextmoca.com
NEXT_MOCA_API_KEY=

# Optional. Defaults to https://api.nextmoca.com.
# NEXT_MOCA_API_BASE=https://api.nextmoca.com

# --- Wrapper auth (the TrueFoundry gateway calls us with this Bearer token) ---
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
WRAPPER_API_KEY=change-me-to-a-random-string

# Local development only: serve the rail without bearer auth.
# ALLOW_NO_AUTH=true

# --- Server runtime ---
PORT=8000
LOG_LEVEL=info

# --- Deploy-time only (filled in before running deploy.py) ---
TFY_WORKSPACE_FQN=<cluster>:<workspace>
TFY_PUBLIC_HOST=ml.<cluster>.truefoundry.cloud
TFY_PUBLIC_PATH=/next-moca-guardrails-tfy
WRAPPER_API_KEY_SECRET_FQN=tfy-secret://<workspace>/next-moca-guardrails-tfy/wrapper-api-key
NEXT_MOCA_API_KEY_SECRET_FQN=tfy-secret://<workspace>/next-moca-guardrails-tfy/next-moca-api-key
