# Copy to .env and fill in. Do NOT commit .env.

# --- Mode ---
# Self-hosted: set WRAPPER_API_KEY and NEXT_MOCA_API_KEY below.
# Forwarded key (one endpoint for many customers): leave both unset; each
# customer's Next Moca key arrives in the gateway's Authorization header.

# --- Next Moca account (self-hosted only) ---
# API key minted in the Next Moca console: https://console.nextmoca.com
NEXT_MOCA_API_KEY=

# Optional. Defaults to https://api.nextmoca.com.
# NEXT_MOCA_API_BASE=https://api.nextmoca.com

# --- Wrapper auth, self-hosted only (the TrueFoundry gateway calls us with this Bearer token) ---
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Leave empty for forwarded-key mode.
WRAPPER_API_KEY=

# --- Server runtime ---
PORT=8000
LOG_LEVEL=info

# --- Deploy-time only (filled in before running deploy.py) ---
TFY_WORKSPACE_FQN=<cluster>:<workspace>
TFY_PUBLIC_HOST=ml.<cluster>.truefoundry.cloud
TFY_PUBLIC_PATH=/next-moca-guardrails-tfy
WRAPPER_API_KEY_SECRET_FQN=tfy-secret://<workspace>/next-moca-guardrails-tfy/wrapper-api-key
NEXT_MOCA_API_KEY_SECRET_FQN=tfy-secret://<workspace>/next-moca-guardrails-tfy/next-moca-api-key
